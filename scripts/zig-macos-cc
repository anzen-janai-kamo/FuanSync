#!/usr/bin/env bash
set -eu
args=()
skip_next=0
for arg in "$@"; do
    if [ "$skip_next" = 1 ]; then skip_next=0; continue; fi
    case "$arg" in
        -arch|-target) skip_next=1; continue ;;
        --target=*) continue ;;
        -gfull) args+=("-g") ;;
        *) args+=("$arg") ;;
    esac
done
exec "${ZIG:-zig}" cc -target x86_64-macos-none "${args[@]}"
